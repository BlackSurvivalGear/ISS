rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function superAdmin(){ return signedIn() && request.auth.token.email == "admin@lawal.org"; }
    function userDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function companyMember(companyId){ return signedIn() && userDoc().data.companyId == companyId && userDoc().data.status == "active"; }
    function companyOwner(companyId){ return companyMember(companyId) && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid; }
    function invite(companyId, invitationId){ return get(/databases/$(database)/documents/companies/$(companyId)/invitations/$(invitationId)); }
    function validInvitation(companyId){
      return signedIn()
        && request.resource.data.companyId == companyId
        && request.resource.data.invitationId is string
        && invite(companyId, request.resource.data.invitationId).data.email == request.auth.token.email
        && invite(companyId, request.resource.data.invitationId).data.status == "pending";
    }
    function protectedMembershipUnchanged(){
      return request.resource.data.companyId == resource.data.companyId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.siteId == resource.data.siteId
        && request.resource.data.invitationId == resource.data.invitationId;
    }
    match /workspaceSlugs/{slug} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.companyId == request.auth.uid;
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && (request.resource.data.companyId == uid || validInvitation(request.resource.data.companyId));
      allow read: if signedIn() && (superAdmin() || request.auth.uid == uid || companyMember(resource.data.companyId));
      allow update: if signedIn() && request.auth.uid == uid && protectedMembershipUnchanged();
      allow delete: if signedIn() && companyOwner(resource.data.companyId);
    }
    match /companies/{companyId} {
      allow create: if signedIn() && request.auth.uid == companyId && request.resource.data.ownerUid == request.auth.uid;
      allow read: if superAdmin() || companyMember(companyId);
      allow update: if companyMember(companyId);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
      match /invitations/{invitationId} {
        allow read: if superAdmin() || companyMember(companyId) || (signedIn() && resource.data.email == request.auth.token.email);
        allow create: if signedIn() && request.auth.uid == companyId;
        allow update: if companyMember(companyId) || (signedIn() && resource.data.email == request.auth.token.email && resource.data.status == "pending" && request.resource.data.status == "active" && request.resource.data.acceptedUid == request.auth.uid);
        allow delete: if companyOwner(companyId) && resource.data.status == "suspended";
      }
      match /sites/{siteId} {
        allow read: if superAdmin() || companyMember(companyId);
        allow create, update: if companyMember(companyId);
        allow delete: if companyOwner(companyId) && resource.data.status == "suspended";
      }
      match /{document=**} {
        allow read: if superAdmin() || companyMember(companyId);
        allow create: if signedIn() && request.auth.uid == companyId;
        allow update, delete: if companyMember(companyId);
      }
    }
  }
}
